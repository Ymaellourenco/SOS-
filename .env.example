# Other
# Fonte secundária de incêndios (api.fogos.pt) — combina com a fogosagora.pt para preencher lacunas
FOGOS_API_TOKEN=
# Deteção de focos de calor via satélite NASA (grátis, registo instantâneo em firms.modaps.eosdis.nasa.gov/api/map_key)
FIRMS_MAP_KEY=
# Domínio do site em produção (ex: https://sosmais.pt), usado para restringir o CORS.
# Deixa vazio em desenvolvimento — o localhost já está sempre permitido.
ALLOWED_ORIGIN=
# SMS reais para os contactos de emergência (twilio.com/try-twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
